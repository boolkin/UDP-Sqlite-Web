{
  "UdpSettings": {
    "Port": 3310,
    "DataType": "float",
    "ByteOrder": "ABCD",
    "EnableInfoLogging": false
  },
  "DatabaseSettings": {
    "FileName": "data2.db",
    "Tables": ["RawData", "AvgData", "WorkTime"],
    "ColumnCount": 10,
    "Headers": ["Температура", "Давление", "Влажность", "Скорость", "Напряжение", "Ток", "Мощность", "Обороты", "Вибрация", "Шум"],
    "RetentionDays": 3
  },
  "TriggerSettings": {
    "Enabled": true,
    "IntervalHours": 12,
    "Threshold": 0.9,
    "TimezoneShift": -5
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5000"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  }
}
